# Copy this file to local.env and replace the placeholder paths.
# local.env is ignored by Git.
#
# Environment management is uv-based (see env/README.md). Run:
#   source env/activate.sh
# which exports AGRI_PY_GS, AGRI_PY_JEPA, CUDA_HOME and the gcc-11 compilers.

# Where the two uv venvs live (created by `bash env/bootstrap.sh all`).
export AGRI_ENVS_ROOT=/fj/AgriGaussian-JEPA/Gaussian-JEPA/envs
export AGRI_PY_GS="$AGRI_ENVS_ROOT/agri-gs/bin/python"
export AGRI_PY_JEPA="$AGRI_ENVS_ROOT/agri-jepa/bin/python"

# Dataset roots for the official Gaussian-JEPA loaders.
export SHAPENET55GS_PLY_ROOT=/path/to/shapesplat_ply
export MODELNETGS_PLY_ROOT=/path/to/modelsplat_ply

# The tracked splits are used by default. Override them only when needed.
# export SHAPENET55GS_SPLIT_ROOT=/path/to/Gaussian-JEPA/datasets/shapenet_split
# export MODELNETGS_SPLIT_ROOT=/path/to/Gaussian-JEPA/datasets/modelnet_split

# CUDA toolchain, unpacked under envs/toolchain by env/bootstrap.sh.
# These are NOT exported by env/activate.sh: they are CUDA 11.8 (needed to build
# the JEPA extensions) and would break the 3DGS env, whose torch is cu128.
# Source env/activate-jepa-build.sh only when building the extensions.
# export CUDA_HOME="$AGRI_ENVS_ROOT/toolchain/cuda-11.8"
# export CC="$AGRI_ENVS_ROOT/toolchain/gcc-11/usr/bin/gcc-11"
# export CXX="$AGRI_ENVS_ROOT/toolchain/gcc-11/usr/bin/g++-11"
# export CUDAHOSTCXX="$CXX"
# export TORCH_CUDA_ARCH_LIST=9.0  # H100/H200; default covers sm_75..sm_89

# Optional ShapeNet-Part roots.
# export PARTANNO_ROOT=/path/to/shapenetcore_partanno_segmentation_benchmark_v0_normal
# export PARTSEG_GS_ROOT=/path/to/shapenet_part_gaussians
